using System;
using System;
using System.Windows.Forms;

namespace Payroll_with_Overtime
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void calculateButton_Click(object sender, EventArgs e)
        {
        }const int OVERTIME_THRESHOLD = 40; 
            const decimal OVERTIME_RATE = 1.5m;
        const decimal REGULAR_RATE = 1.0m;  
        decimal hoursWorked;
        decimal hourlyPayRate;
        decimal grossPay;

        // 
        try
        {
          hoursWorked = decimal.Parse(hoursWorkedTextBox.Text);
            hourlyPayRate = decimal.Parse(hourlyPayRateTextBox.Text);
    
                // Calculate the gross pay.                                             
                if (hoursWorked > OVERTIME_THRESHOLD)
                {
                    decimal regularHours = OVERTIME_THRESHOLD;
                    decimal overtimeHours = hoursWorked - OVERTIME_THRESHOLD;
                    grossPay = (regularHours * hourlyPayRate * REGULAR_RATE) +
                             (overtimeHours * hourlyPayRate * OVERTIME_RATE);
                }
                else
                {
                    grossPay = hoursWorked * hourlyPayRate * REGULAR_RATE;
                }
    
                // Display the gross pay.
                grossPayLabel.Text = grossPay.ToString("C");













private void clearButton_Click(object sender, EventArgs e)
        {
            // Clear the TextBoxes and gross pay label.
            hoursWorkedTextBox.Text = "";
            hourlyPayRateTextBox.Text = "";
            grossPayLabel.Text = "";

            // Reset the focus.
            hoursWorkedTextBox.Focus();
        }

        private void exitButton_Click(object sender, EventArgs e)
        {
            // Close the form.
            this.Close();
        }
    }
}
